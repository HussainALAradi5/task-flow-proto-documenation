          }
        },
        {
          "name": "Update Team",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/teams/{{teamId}}",
              "host": ["{{baseUrl}}"],
              "path": ["teams", "{{teamId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated description\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Delete Team (Admin Only)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/teams/{{teamId}}",
              "host": ["{{baseUrl}}"],
              "path": ["teams", "{{teamId}}"]
            }
          }
        }
      ]
